# Secreto para firmar los JWT (HS256). Mínimo 32 caracteres.
# En producción, usar un valor largo y aleatorio. NO usar el de desarrollo.
JWT__SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-minimo-32-caracteres

# Fecha base para los datos semilla (ISO-8601 UTC). Opcional.
# Si no se define, usa 2026-01-15T08:00:00Z por defecto.
SEED_FECHA_BASE=2026-01-15T08:00:00Z